# Copy to .env — auto-loaded. Only needed for remote browsers.
BROWSER_USE_API_KEY=bu_your_key_here

# Optional governed-operations state directory. Defaults to the Browser Harness workspace.
# BH_GOVERNANCE_DIR=/absolute/path/to/private/browserops-state

# Browser recordings remain opt-in and are not enabled by BrowserOps.
BH_RECORD=0
